# ── Stage 1: Azure OpenAI via Foundry ────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# ── Stage 2: Foundry IQ (Azure AI Search knowledge base) ─────────────────────
AZURE_AI_SEARCH_SERVICE_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_AI_SEARCH_KNOWLEDGE_BASE_NAME=<your-kb-name>

# ── Stage 4: Foundry Hosted Agent ────────────────────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_TOOLBOX_NAME=<your-toolbox-name>
KB_MCP_CONNECTION_ID=<your-kb-connection-id>

# ── Optional: API key auth (only works if DisableLocalAuth=false on search) ───
# AZURE_AI_SEARCH_API_KEY=<your-search-api-key>
